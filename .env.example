# Copy this file to .env and fill in real values. Never commit .env.

# Hugging Face Hub token (required for gated/pretrained model downloads)
HUGGINGFACE_TOKEN=

# Where pretrained model weights are cached locally
HF_HOME=./models/cache
TORCH_HOME=./models/cache

# Device selection: "cuda" | "cpu" | "auto"
DEVICE=auto

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
