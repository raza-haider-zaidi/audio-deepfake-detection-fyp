# Copy this file to .env and fill in real values. Never commit .env.

# Hugging Face Hub token (required for gated/pretrained model downloads)
HUGGINGFACE_TOKEN=

# Where pretrained model weights are cached locally
HF_HOME=./models/cache
TORCH_HOME=./models/cache

# Device selection: "cpu" | "auto" (both resolve to CPU — this project has
# no CUDA/GPU code path; see src/audio_deepfake_detector/utils/device.py)
DEVICE=auto

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
